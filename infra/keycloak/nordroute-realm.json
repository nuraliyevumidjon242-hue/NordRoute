{
  "realm": "nordroute",
  "enabled": true,
  "displayName": "NordRoute",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full platform administration" },
      { "name": "dispatcher", "description": "Manage dispatch operations and route proposals" },
      { "name": "viewer", "description": "Read-only operational dashboard access" },
      { "name": "dpo", "description": "Read operational data and audit records" }
    ]
  },
  "clientScopes": [
    {
      "name": "nordroute-api-audience",
      "description": "Adds the dashboard client as an access-token audience",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "nordroute-dashboard-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nordroute-dashboard",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nordroute-dashboard",
      "name": "NordRoute Dashboard",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/",
        "http://127.0.0.1:8000/"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "nordroute-api-audience"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    }
  ],
  "users": []
}
